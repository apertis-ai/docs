{
  "name": "apertis-docs-nimbus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test \"test/*.test.ts\"",
    "preview": "cd .. && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false WRANGLER_SEND_METRICS=false wrangler pages dev site-nimbus/dist --compatibility-date=2024-01-01 --persist-to site-nimbus/.wrangler/state",
    "test:routes": "node --test test/routes.check.ts",
    "test:dist": "node --test test/dist.check.ts"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@cloudflare/nimbus-docs": "0.15.0",
    "astro": "7.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "pagefind": "1.5.2",
    "typescript": "5.9.3",
    "wrangler": "4.95.0"
  }
}
