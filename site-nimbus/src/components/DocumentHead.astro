---
// Document identity for one manifest entry: <title>, canonical and the apertis-docs:* metas.
// Charset/viewport belong to the page or layout head. Do not combine with Nimbus's NimbusHead,
// which emits its own canonical (from Astro.url.pathname) and a sitemap-index link.
import type { ManifestDocument } from '../contracts/manifest.ts';
import { PAGE_META, TITLE_SUFFIX } from '../contracts/page.ts';

interface Props {
  doc: ManifestDocument;
  buildId: string;
}
const { doc, buildId } = Astro.props;
---
<title>{doc.title + TITLE_SUFFIX}</title>
<link rel="canonical" href={doc.canonicalUrl} />
<meta name={PAGE_META.id} content={doc.id} />
<meta name={PAGE_META.build} content={buildId} />
{doc.markdown && <meta name={PAGE_META.markdown} content={doc.markdown.path} />}
