---
// Head metadata for one manifest entry: title, canonical and the apertis-docs:* metas.
import type { ManifestDocument } from '../contracts/manifest.ts';
import { PAGE_META } from '../contracts/page.ts';

interface Props {
  doc: ManifestDocument;
  buildId: string;
}
const { doc, buildId } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{doc.title} | Apertis Documentation</title>
<link rel="canonical" href={doc.canonicalUrl} />
<meta name={PAGE_META.id} content={doc.id} />
<meta name={PAGE_META.build} content={buildId} />
{doc.markdown && <meta name={PAGE_META.markdown} content={doc.markdown.path} />}
