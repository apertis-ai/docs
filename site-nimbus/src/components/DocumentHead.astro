---
// Document identity for one manifest entry: <title>, canonical, search/social metadata and the
// apertis-docs:* metas. Charset/viewport belong to the page or layout head. Do not combine with Nimbus's
// NimbusHead, which emits its own canonical (from Astro.url.pathname) and a sitemap-index link.
// The description comes from the page's front matter only (never generated); without one the description,
// og:description and twitter:description tags are omitted.
import type { ManifestDocument } from '../contracts/manifest.ts';
import { MANIFEST_SITE } from '../contracts/manifest.ts';
import { PAGE_META, TITLE_SUFFIX, bylineAuthor, safeJsonLd, servedUrl, type SeoProps } from '../contracts/page.ts';

interface Props extends SeoProps {
  doc: ManifestDocument;
  buildId: string;
}
const { doc, buildId, description = null, updated, article = false, trail = [], post } = Astro.props;
const url = doc.canonicalUrl ? servedUrl(doc.canonicalUrl) : null;
const fullTitle = doc.title + TITLE_SUFFIX;
const desc = description?.replace(/\s+/g, ' ').trim() || null;
// A native article is shared as a post: its own title without the site suffix, a large card, a byline.
const socialTitle = post ? doc.title : fullTitle;
const image = post?.image ? new URL(post.image.src, MANIFEST_SITE).toString() : null;
const author = post ? bylineAuthor(post.author) : null;
const jsonLd = url && article ? [
  {
    '@context': 'https://schema.org',
    '@type': post ? 'BlogPosting' : 'TechArticle',
    headline: doc.title,
    url,
    mainEntityOfPage: url,
    ...(desc ? { description: desc } : {}),
    ...(post ? { datePublished: post.published, author } : {}),
    ...(updated ? { dateModified: updated } : {}),
    ...(image ? { image } : {}),
    publisher: { '@type': 'Organization', name: 'Apertis', url: 'https://apertis.ai' },
  },
  ...(trail.length ? [{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    // Google requires `item` on every crumb but the last, and sidebar categories have no page, so only
    // Home and the page itself are listed.
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: servedUrl('https://docs.apertis.ai/') },
      { '@type': 'ListItem', position: 2, name: trail[trail.length - 1], item: url },
    ],
  }] : []),
] : [];
---
<title>{fullTitle}</title>
{url && <link rel="canonical" href={url} />}
{desc && <meta name="description" content={desc} />}
{url && <meta property="og:url" content={url} />}
{author && <meta name="author" content={author.name} />}
{url && <meta property="og:title" content={socialTitle} />}
{url && desc && <meta property="og:description" content={desc} />}
{url && <meta property="og:type" content={article ? 'article' : 'website'} />}
{url && <meta property="og:site_name" content="Apertis Documentation" />}
{url && post && <meta property="article:published_time" content={post.published} />}
{url && image && <meta property="og:image" content={image} />}
{url && image && <meta property="og:image:width" content={String(post!.image!.width)} />}
{url && image && <meta property="og:image:height" content={String(post!.image!.height)} />}
{url && image && <meta property="og:image:alt" content={doc.title} />}
{url && <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />}
{url && <meta name="twitter:title" content={socialTitle} />}
{url && image && <meta name="twitter:image" content={image} />}
{url && desc && <meta name="twitter:description" content={desc} />}
{jsonLd.map((block) => <script type="application/ld+json" set:html={safeJsonLd(block)} />)}
<meta name={PAGE_META.id} content={doc.id} />
<meta name={PAGE_META.build} content={buildId} />
{doc.markdown && <meta name={PAGE_META.markdown} content={doc.markdown.path} />}
