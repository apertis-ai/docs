---
// Mount point for search and Ask Docs (#9 owns this directory). DocLayout renders it once per page;
// the shell opens it only through the `apertis-docs:open` event (src/contracts/events.ts), and
// assistant.ts is the one Cmd/Ctrl+K owner. One <dialog> hosts both surfaces: Search is modal
// (showModal, scroll locked), Ask Docs is a non-blocking docked panel (show).
---
<dialog id="apertis-assistant" class="aa" aria-label="Search documentation" data-pagefind-ignore="all">
  <div class="aa-frame">
    <div class="aa-head">
      <div class="aa-tabs" role="tablist" aria-label="Assistant">
        <button type="button" role="tab" id="aa-tab-search" aria-controls="aa-search" aria-selected="true" data-surface="search">Search</button>
        <button type="button" role="tab" id="aa-tab-ask" aria-controls="aa-ask" aria-selected="false" data-surface="ask">Ask Docs</button>
      </div>
      <button type="button" class="aa-close" id="aa-close" aria-label="Close">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
    </div>

    <section id="aa-search" class="aa-search" role="tabpanel" aria-labelledby="aa-tab-search">
      <div class="aa-field">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        <input id="aa-q" type="text" role="combobox" aria-label="Search the documentation" aria-expanded="false"
          aria-controls="aa-results" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Search docs" />
      </div>
      <p id="aa-status" class="aa-status" role="status" aria-live="polite">Type to search the documentation</p>
      <ul id="aa-results" class="aa-results" role="listbox" aria-label="Search results"></ul>
    </section>

    <section id="aa-ask" class="aa-ask" role="tabpanel" aria-labelledby="aa-tab-ask" hidden>
      <p class="aa-context">Using current page <span id="aa-context-title" class="aa-chip"></span></p>
      <div id="aa-messages" class="aa-messages" aria-live="polite"></div>
      <p id="aa-ask-status" class="aa-ask-status" role="alert"></p>
      <form id="aa-form" class="aa-form">
        <textarea id="aa-question" rows="2" maxlength="2000" aria-label="Ask a question about the documentation" placeholder="Ask a question..."></textarea>
        <button type="submit" id="aa-send" disabled>Send</button>
      </form>
      <div class="aa-foot">
        <span>Enter to send, Shift+Enter for a new line.</span>
        <button type="button" id="aa-clear" class="aa-clear" hidden>Clear chat</button>
      </div>
      <div id="aa-turnstile" class="aa-turnstile"></div>
    </section>
  </div>
</dialog>

<script>
  import './assistant.ts';
</script>

<style is:global>
  .aa {
    --aa-accent: #0d7f73;
    --aa-border: #e2e8f0;
    --aa-muted: #64748b;
    --aa-bg: #fff;
    --aa-text: #0f172a;
    border: 1px solid var(--aa-border);
    border-radius: 12px;
    padding: 0;
    color: var(--aa-text);
    background: var(--aa-bg);
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18);
    font: 14px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  .aa::backdrop { background: rgba(15, 23, 42, 0.35); }
  .aa[data-surface='search'] { width: min(640px, calc(100vw - 32px)); margin: 80px auto auto; max-height: calc(100vh - 120px); }
  .aa[data-surface='ask'] {
    position: fixed; inset: 64px 16px 16px auto; margin: 0; width: min(420px, calc(100vw - 32px)); height: auto; max-height: none; z-index: 1000;
  }
  html.aa-scroll-lock { overflow: hidden; }
  .aa-frame { display: flex; flex-direction: column; max-height: inherit; height: 100%; }
  .aa-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--aa-border); }
  .aa-tabs { display: inline-flex; gap: 4px; padding: 3px; border-radius: 999px; background: #f1f5f9; }
  .aa-tabs button { border: 0; border-radius: 999px; padding: 4px 12px; background: none; color: var(--aa-muted); font: inherit; cursor: pointer; }
  .aa-tabs button[aria-selected='true'] { background: var(--aa-accent); color: #fff; }
  .aa-close, .aa-clear { border: 0; background: none; color: var(--aa-muted); cursor: pointer; padding: 4px; font: inherit; }
  .aa button:focus-visible, .aa a:focus-visible, .aa textarea:focus-visible { outline: 2px solid var(--aa-accent); outline-offset: 2px; }
  .aa-search { display: flex; flex-direction: column; min-height: 0; padding: 12px; }
  .aa-field { display: flex; align-items: center; gap: 8px; border: 2px solid var(--aa-accent); border-radius: 8px; padding: 8px 10px; color: var(--aa-muted); }
  .aa-field input { flex: 1; border: 0; outline: 0; font: inherit; font-size: 16px; color: var(--aa-text); background: none; min-width: 0; }
  .aa-status { margin: 10px 4px; color: var(--aa-muted); text-align: center; }
  .aa-status:empty { display: none; }
  .aa-results { list-style: none; margin: 8px 0 0; padding: 0; overflow-y: auto; }
  .aa-results li { border-radius: 8px; }
  .aa-results li[aria-selected='true'] { background: #ecfdf5; box-shadow: inset 3px 0 0 var(--aa-accent); }
  .aa-results a { display: block; padding: 8px 12px; color: inherit; text-decoration: none; }
  .aa-results .aa-title { display: block; font-weight: 600; }
  .aa-results .aa-path { display: block; color: var(--aa-muted); font-size: 12px; }
  .aa-results .aa-excerpt { display: block; color: #334155; font-size: 13px; }
  .aa-results mark { background: #ccfbf1; color: inherit; }
  .aa-ask { display: flex; flex-direction: column; flex: 1; min-height: 0; padding: 12px; gap: 8px; }
  .aa-context { margin: 0; color: var(--aa-muted); font-size: 12px; }
  .aa-chip { display: inline-block; margin-left: 4px; padding: 1px 8px; border: 1px solid var(--aa-border); border-radius: 6px; color: var(--aa-text); }
  .aa-messages { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
  .aa-msg { padding: 8px 10px; border-radius: 8px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .aa-msg[data-role='user'] { align-self: flex-end; background: #f1f5f9; max-width: 85%; }
  .aa-msg[data-role='assistant'] { border: 1px solid var(--aa-border); }
  .aa-msg[data-state='error'] { border-color: #fca5a5; background: #fef2f2; color: #991b1b; }
  .aa-msg a { color: var(--aa-accent); }
  .aa-note { display: block; margin-top: 6px; color: #b45309; font-size: 12px; white-space: normal; }
  .aa-sources { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; white-space: normal; }
  .aa-sources a { padding: 2px 8px; border: 1px solid var(--aa-border); border-radius: 999px; font-size: 12px; text-decoration: none; }
  .aa-ask-status { margin: 0; font-size: 13px; color: var(--aa-muted); }
  .aa-ask-status:empty { display: none; }
  .aa-ask-status[data-kind='error'] { padding: 8px 10px; border-radius: 8px; background: #fef2f2; color: #991b1b; border: 1px solid #fca5a5; }
  .aa-form { display: flex; gap: 8px; align-items: flex-end; border: 2px solid var(--aa-accent); border-radius: 10px; padding: 8px; }
  .aa-form textarea { flex: 1; border: 0; outline: 0; resize: none; font: inherit; font-size: 16px; color: var(--aa-text); background: none; }
  .aa-form button { border: 0; border-radius: 8px; padding: 6px 12px; background: var(--aa-accent); color: #fff; font: inherit; cursor: pointer; }
  .aa-form button:disabled { background: #cbd5e1; cursor: not-allowed; }
  .aa-foot { display: flex; justify-content: space-between; align-items: center; color: var(--aa-muted); font-size: 12px; }
  .aa-turnstile:empty { display: none; }
  @media (max-width: 640px) {
    .aa[data-surface='search'] { width: 100vw; max-width: 100vw; margin: auto 0 0; max-height: 90vh; border-radius: 16px 16px 0 0; }
    .aa[data-surface='ask'] { inset: auto 0 0 0; width: 100vw; max-width: 100vw; height: min(82vh, 680px); border-radius: 14px 14px 0 0; }
  }
</style>
