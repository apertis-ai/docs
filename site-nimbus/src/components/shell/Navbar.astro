---
// Header per openspec docs-shell-interfaces "Shell alignment, header, footer and homepage", in two rows as
// in the Claude Docs header. Top row: logo and name, a centred search trigger with the Cmd/Ctrl+K hint,
// the theme switch, a thin separator, Log in (quiet) and Create account (primary). Second row: the navbar
// items of "Preserved reader-facing shell" as section tabs, the current one underlined. Server-rendered;
// the search trigger only dispatches `apertis-docs:open` (shell.client.ts), Cmd/Ctrl+K belongs to #9.
// Below 1024 px the tab row and the account actions move into the navigation sheet (NavSheet.tsx).
import { ArrowUpRight, Menu, Moon, Search, Sun } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import type { SidebarId } from '../../contracts/navigation.ts';

interface Props {
  sidebar: SidebarId | null;
}
const { sidebar } = Astro.props;
const external = { target: '_blank', rel: 'noopener noreferrer' };
const links = [
  { label: 'Docs', href: '/intro', current: sidebar === 'tutorialSidebar' },
  { label: 'API Reference', href: '/api', current: sidebar === 'apiSidebar' },
  { label: 'Release Notes', href: 'https://apertis.ai/changelog', current: false, external: true },
];
---
<header class="navbar">
  <div class="shell-container navbar__inner">
    <a class="brand" href="/"><img src="/img/logo.svg" alt="" width="24" height="24" /><span>Apertis Docs</span></a>
    <div class="navbar__center">
      <button type="button" class="navbar__search" data-open-surface="search" aria-label="Search documentation" aria-keyshortcuts="Meta+K Control+K">
        <Search className="size-4" aria-hidden="true" />
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>
    </div>
    <div class="navbar__right">
      <button type="button" data-slot="button" class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'icon-button')} data-theme-toggle aria-label="Switch to dark mode">
        <Sun className="icon-sun size-[18px]" aria-hidden="true" />
        <Moon className="icon-moon size-[18px]" aria-hidden="true" />
      </button>
      <span class="navbar__sep" aria-hidden="true"></span>
      <a data-slot="button" class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'navbar__login')} href="https://apertis.ai/login" {...external}>Log in</a>
      <a data-slot="button" class={cn(buttonVariants({ size: 'sm' }), 'navbar__signup')} href="https://apertis.ai/register" {...external}>Create account</a>
    </div>
    <div class="navbar__compact">
      <button type="button" data-slot="button" class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'icon-button')} data-open-surface="search" aria-label="Search documentation">
        <Search className="size-[18px]" aria-hidden="true" />
      </button>
      <button type="button" data-slot="button" class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'icon-button navbar__menu')} data-drawer-open aria-label="Open navigation" aria-expanded="false">
        <Menu className="size-5" aria-hidden="true" />
      </button>
    </div>
  </div>
  <div class="shell-container navbar__tabs">
    <nav class="navbar__links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={{ active: l.current }} aria-current={l.current ? 'true' : undefined} {...(l.external ? external : {})}>{l.label}{l.external && <ArrowUpRight className="size-3.5" aria-hidden="true" />}</a>
      ))}
    </nav>
  </div>
</header>
