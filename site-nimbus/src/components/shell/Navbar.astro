---
// Navbar items per openspec docs-shell-interfaces "Preserved reader-facing shell". The search trigger
// only dispatches `apertis-docs:open` (shell.client.ts); Cmd/Ctrl+K belongs to #9.
import type { SidebarId } from '../../contracts/navigation.ts';

interface Props {
  sidebar: SidebarId | null;
}
const { sidebar } = Astro.props;
const external = { target: '_blank', rel: 'noopener noreferrer' };
const ext = '<svg class="ext" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/></svg>';
---
<header class="navbar">
  <button type="button" class="icon-button navbar__menu" data-drawer-open aria-label="Open navigation" aria-controls="shell-drawer" aria-expanded="false">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
  </button>
  <a class="brand" href="/"><img src="/img/logo.svg" alt="" width="24" height="24" /><span>Apertis Docs</span></a>
  <nav class="navbar__links" aria-label="Main">
    <a href="/intro" class:list={{ active: sidebar === 'tutorialSidebar' }} aria-current={sidebar === 'tutorialSidebar' ? 'true' : undefined}>Docs</a>
    <a href="/api" class:list={{ active: sidebar === 'apiSidebar' }} aria-current={sidebar === 'apiSidebar' ? 'true' : undefined}>API Reference</a>
    <a href="https://apertis.ai/changelog" {...external}>Release Notes<Fragment set:html={ext} /></a>
  </nav>
  <div class="navbar__right">
    <a class="navbar__login" href="https://apertis.ai/login" {...external}>Log in<Fragment set:html={ext} /></a>
    <a class="navbar__signup" href="https://apertis.ai/register" {...external}>Create account<Fragment set:html={ext} /></a>
    <button type="button" class="icon-button" data-theme-toggle aria-label="Switch to dark mode">
      <svg class="icon-sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <svg class="icon-moon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <button type="button" class="navbar__search" data-open-surface="search" aria-label="Search documentation">
      <span>Search</span><kbd>⌘</kbd><kbd>K</kbd>
    </button>
  </div>
</header>
