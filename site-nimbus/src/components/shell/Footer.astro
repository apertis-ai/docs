---
// Footer aligned with the apertis.ai footer (operator review 2026-10-03; stima-api web/next marketing
// Footer, contract web/shared/marketing-chrome/contract.json): a brand column (mark, name, one line and the
// service status link), then Product, Resources, Developers, Contact and Legal, and a bottom row with the
// copyright, the trust facts and the trust links. apertis.ai pages open in a new tab; the Developers column
// and Blog point into this site. "API Documentation" of the apertis.ai footer is this site, so Resources
// carries the Blog in its place.
import { Badge } from '@/components/ui/badge';
import Logo from './Logo.tsx';

const site = 'https://apertis.ai';
const columns: { title: string; links: [string, string, string?][] }[] = [
  { title: 'Product', links: [['Coding Plan', `${site}/subscribe`, 'New'], ['Helmway', `${site}/brand`, 'Coming'], ['Models', `${site}/models`], ['Pricing', `${site}/models`], ['Cost Calculator', `${site}/calculator`], ['Chat', 'https://chat.apertis.ai']] },
  { title: 'Resources', links: [['Blog', '/blog/'], ['Enterprise', `${site}/enterprise`], ['Research', `${site}/research`], ['Brand', `${site}/brand`], ['Academic Access', `${site}/academic`], ['Changelog', `${site}/changelog`], ['Ideas', `${site}/ideas`], ['Compare', `${site}/compare`], ['Service Status', 'https://status.apertis.ai']] },
  { title: 'Developers', links: [['API Reference', '/api/text-generation/chat-completions/'], ['Quickstart Guide', '/intro/'], ['SDKs & Libraries', '/installation/scripts/'], ['Agent Skill', 'https://github.com/apertis-ai/apertis-skills'], ['MCP Server', '/api/sdks/mcp-server/']] },
  { title: 'Contact', links: [['Email', 'mailto:hi@apertis.ai'], ['Facebook', 'https://www.facebook.com/stimaai/'], ['Instagram', 'https://www.instagram.com/stimatech'], ['LinkedIn', 'https://www.linkedin.com/company/apertis-ai'], ['GitHub', 'https://github.com/apertis-ai/apertis-api']] },
  { title: 'Legal', links: [['Terms of Service', `${site}/terms`], ['Privacy Policy', `${site}/privacy`], ['Refund Policy', `${site}/refund`], ['GitHub Promotion', `${site}/github-promotion-policy`], ['DPA (Data Processing)', `${site}/trust`], ['Compliance & Security', `${site}/trust`]] },
];
// Trust badges as the apertis.ai footer draws them (Footer.tsx FooterTrustBadgeIcon): the AWS mark (wordmark in the
// text colour, smile in AWS orange) and stroke icons for PCI DSS, DPA and MFA.
const trust = [['aws', 'AWS', 'Partner Network Member', 'https://aws.amazon.com/partners/'], ['pci', 'PCI DSS', 'via Stripe', `${site}/trust`], ['dpa', 'DPA', 'Available', `${site}/trust/dpa`], ['mfa', 'MFA', 'Supported', `${site}/trust`]];
const stroke = { viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': '1.6', 'stroke-linecap': 'round', 'stroke-linejoin': 'round', 'aria-hidden': 'true' } as const;
const bottom = [['Security & Compliance', `${site}/trust`], ['DPA requests', `${site}/trust/dpa`], ['Service Status', 'https://status.apertis.ai']];
const external = { target: '_blank', rel: 'noopener noreferrer' };
const attrs = (href: string) => (href.startsWith('/') || href.startsWith('mailto:') ? {} : external);
---
<footer class="footer">
  <div class="shell-container footer__inner">
    <div class="footer__brand">
      <a class="brand" href="/"><Logo /><span>Apertis</span></a>
      <p class="footer__line">Apertis AI by STIMA AI LLC.</p>
      <!-- shell.client.ts sets the state from status.apertis.ai/index.json, as the apertis.ai FooterStatus does. -->
      <a class="footer__status" href="https://status.apertis.ai" aria-label="Service status: Checking system status" data-footer-status {...external}>
        <span class="footer__status-indicator loading" role="presentation"></span><span class="footer__status-text">Checking system status</span>
      </a>
    </div>
    <div class="footer__columns">
      {columns.map((c) => (
        <div>
          <p class="footer__title">{c.title}</p>
          <ul>
            {c.links.map(([label, href, badge]) => (
              <li><a href={href} {...attrs(href)}>{label}</a>{badge && <Badge variant="outline" className="footer__badge text-muted-foreground">{badge}</Badge>}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="shell-container footer__bottom">
    <ul class="footer__trust" aria-label="Trust">
      {trust.map(([icon, name, fact, href]) => (
        <li>
          <a href={href} {...external}>
            <span class="footer__trust-icon" role="presentation">
              {icon === 'aws' && (
                <svg class="footer__aws" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
                  <path d="M6.763 11.212c0 .296.032.535.088.71.064.176.144.368.256.576.04.063.056.127.056.183 0 .08-.048.16-.152.24l-.503.335a.383.383 0 01-.208.072c-.08 0-.16-.04-.239-.112a2.47 2.47 0 01-.287-.375 6.18 6.18 0 01-.248-.471c-.622.734-1.405 1.101-2.347 1.101-.67 0-1.205-.191-1.596-.574-.39-.384-.59-.894-.59-1.533 0-.678.24-1.23.726-1.644.487-.415 1.133-.623 1.955-.623.272 0 .551.024.846.064.296.04.6.104.918.176v-.583c0-.607-.127-1.03-.375-1.277-.255-.248-.686-.367-1.3-.367-.28 0-.568.031-.863.103-.295.072-.583.16-.862.272a2.4 2.4 0 01-.28.104.488.488 0 01-.127.023c-.112 0-.168-.08-.168-.247v-.391c0-.128.016-.224.056-.28a.597.597 0 01.224-.167 4.577 4.577 0 011.005-.36 4.84 4.84 0 011.246-.151c.95 0 1.644.216 2.091.647.44.43.662 1.085.662 1.963v2.586h.016zm-3.24 1.214c.263 0 .534-.048.822-.144a1.78 1.78 0 00.758-.51 1.27 1.27 0 00.272-.512c.047-.191.08-.423.08-.694v-.335a6.66 6.66 0 00-.735-.136 6.02 6.02 0 00-.75-.048c-.535 0-.926.104-1.19.32-.263.215-.39.518-.39.917 0 .375.095.655.295.846.191.2.47.296.838.296zm6.41.862c-.144 0-.24-.024-.304-.08-.064-.048-.12-.16-.168-.311L7.586 6.726a1.398 1.398 0 01-.072-.32c0-.128.064-.2.191-.2h.783c.151 0 .255.025.31.08.065.048.113.16.16.312l1.342 5.284 1.245-5.284c.04-.16.088-.264.151-.312a.549.549 0 01.32-.08h.638c.152 0 .256.025.32.08.063.048.12.16.151.312l1.261 5.348 1.381-5.348c.048-.16.104-.264.16-.312a.52.52 0 01.311-.08h.743c.127 0 .2.065.2.2 0 .04-.009.08-.017.128a1.137 1.137 0 01-.056.2l-1.923 6.17c-.048.16-.104.263-.168.311a.51.51 0 01-.303.08h-.687c-.15 0-.255-.024-.32-.08-.063-.056-.119-.16-.15-.32L12.32 7.747l-1.23 5.14c-.04.16-.087.264-.15.32-.065.056-.177.08-.32.08l-.686.001zm10.256.215c-.415 0-.83-.048-1.229-.143-.399-.096-.71-.2-.918-.32-.128-.071-.215-.151-.247-.223a.563.563 0 01-.048-.224v-.407c0-.167.064-.247.183-.247.048 0 .096.008.144.024.048.016.12.048.2.08.271.12.566.215.878.279.32.064.63.096.95.096.502 0 .894-.088 1.165-.264a.86.86 0 00.415-.758.777.777 0 00-.215-.559c-.144-.151-.416-.287-.807-.415l-1.157-.36c-.583-.183-1.014-.454-1.277-.813a1.902 1.902 0 01-.4-1.158c0-.335.073-.63.216-.886.144-.255.335-.479.575-.654.24-.184.51-.32.83-.415.32-.096.655-.136 1.006-.136.175 0 .36.008.535.032.183.024.35.056.518.088.16.04.312.08.455.127.144.048.256.096.336.144a.69.69 0 01.24.2.43.43 0 01.071.263v.375c0 .168-.064.256-.184.256a.83.83 0 01-.303-.096 3.652 3.652 0 00-1.532-.311c-.455 0-.815.071-1.062.223-.248.152-.375.383-.375.71 0 .224.08.416.24.567.16.152.454.304.877.44l1.134.358c.574.184.99.44 1.237.767.247.327.367.702.367 1.117 0 .343-.072.655-.207.926a2.157 2.157 0 01-.583.703c-.248.2-.543.343-.886.447-.36.111-.734.167-1.142.167z" />
                  <path fill="#F90" d="M.378 15.475c3.384 1.963 7.56 3.153 11.877 3.153 2.914 0 6.114-.607 9.06-1.852.44-.2.814.287.383.607-2.626 1.94-6.442 2.969-9.722 2.969-4.598 0-8.74-1.7-11.87-4.526-.247-.223-.024-.527.272-.351zm23.531-.2c.287.36-.08 2.826-1.485 4.007-.215.184-.423.088-.327-.151l.175-.439c.343-.88.802-2.198.52-2.555-.336-.43-2.22-.207-3.074-.103-.255.032-.295-.192-.063-.36 1.5-1.053 3.967-.75 4.254-.399z" />
                </svg>
              )}
              {icon === 'pci' && <svg {...stroke}><rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10h18M7 14h4" /></svg>}
              {icon === 'dpa' && <svg {...stroke}><path d="M7 3h7l4 4v14H7z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>}
              {icon === 'mfa' && <svg {...stroke}><rect x="6" y="10" width="12" height="10" rx="2" /><path d="M8 10V8a4 4 0 0 1 8 0v2M12 14v3" /></svg>}
            </span>
            <span class="footer__trust-copy"><strong>{name}</strong><small>{fact}</small></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="footer__legal">
      <p class="footer__copyright">© 2026 STIMA AI LLC</p>
      <ul>
        {bottom.map(([label, href]) => <li><a href={href} {...external}>{label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
