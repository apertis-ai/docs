const columns = [
  { title: 'Product', links: [['Apertis', 'https://api.apertis.ai'], ['Chat', 'https://chat.apertis.ai']] },
  { title: 'Company', links: [['Research', 'https://apertis.ai/research'], ['Status', 'https://status.apertis.ai']] },
  { title: 'Contact', links: [['Email', 'mailto:hi@apertis.ai']] },
];
const external = { target: '_blank', rel: 'noopener noreferrer' };
---
<footer class="footer">
  <div class="shell-container footer__inner">
    <div class="footer__brand">
      <a class="brand" href="/"><img src="/img/logo.svg" alt="" width="24" height="24" /><span>Apertis Docs</span></a>
      <p class="footer__line">One API key for models across leading providers.</p>
      <ul class="footer__social">
        {social.map((s) => (
          <li><a href={s.href} aria-label={s.label} {...external}><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg></a></li>
        ))}
      </ul>
    </div>
    <div class="footer__columns">
      {columns.map((c) => (
        <div>
          <p class="footer__title">{c.title}</p>
          <ul>
            {c.links.map(([label, href]) => (
              <li>{href.startsWith('mailto:') ? <a href={href}>{label}</a> : <a href={href} {...external}>{label}</a>}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="shell-container footer__bottom">
    <p class="footer__copyright">Apertis AI © 2024-2026 STIMA AI LLC. All rights reserved.</p>
  </div>
</footer>
