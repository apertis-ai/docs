---
// Footer aligned with the apertis.ai footer (operator review 2026-10-03; stima-api web/next marketing
// Footer, contract web/shared/marketing-chrome/contract.json): a brand column (mark, name, one line and the
// service status link), then Product, Resources, Developers, Contact and Legal, and a bottom row with the
// copyright, the trust facts and the trust links. apertis.ai pages open in a new tab; the Developers column
// and Blog point into this site. "API Documentation" of the apertis.ai footer is this site, so Resources
// carries the Blog in its place.
import { Badge } from '@/components/ui/badge';
import Logo from './Logo.tsx';

const site = 'https://apertis.ai';
const columns: { title: string; links: [string, string, string?][] }[] = [
  { title: 'Product', links: [['Coding Plan', `${site}/subscribe`, 'New'], ['Helmway', `${site}/brand`, 'Coming'], ['Models', `${site}/models`], ['Pricing', `${site}/models`], ['Cost Calculator', `${site}/calculator`], ['Chat', 'https://chat.apertis.ai']] },
  { title: 'Resources', links: [['Blog', '/blog/'], ['Enterprise', `${site}/enterprise`], ['Research', `${site}/research`], ['Brand', `${site}/brand`], ['Academic Access', `${site}/academic`], ['Changelog', `${site}/changelog`], ['Ideas', `${site}/ideas`], ['Compare', `${site}/compare`], ['Service Status', 'https://status.apertis.ai']] },
  { title: 'Developers', links: [['API Reference', '/api/text-generation/chat-completions/'], ['Quickstart Guide', '/intro/'], ['SDKs & Libraries', '/installation/scripts/'], ['Agent Skill', 'https://github.com/apertis-ai/apertis-skills'], ['MCP Server', '/api/sdks/mcp-server/']] },
  { title: 'Contact', links: [['Email', 'mailto:hi@apertis.ai'], ['Facebook', 'https://www.facebook.com/stimaai/'], ['Instagram', 'https://www.instagram.com/stimatech'], ['LinkedIn', 'https://www.linkedin.com/company/apertis-ai'], ['GitHub', 'https://github.com/apertis-ai/apertis-api']] },
  { title: 'Legal', links: [['Terms of Service', `${site}/terms`], ['Privacy Policy', `${site}/privacy`], ['Refund Policy', `${site}/refund`], ['GitHub Promotion', `${site}/github-promotion-policy`], ['DPA (Data Processing)', `${site}/trust`], ['Compliance & Security', `${site}/trust`]] },
];
const trust = [['AWS', 'Partner Network Member', 'https://aws.amazon.com/partners/'], ['PCI DSS', 'via Stripe', `${site}/trust`], ['DPA', 'Available', `${site}/trust/dpa`], ['MFA', 'Supported', `${site}/trust`]];
const bottom = [['Security & Compliance', `${site}/trust`], ['DPA requests', `${site}/trust/dpa`], ['Service Status', 'https://status.apertis.ai']];
const external = { target: '_blank', rel: 'noopener noreferrer' };
const attrs = (href: string) => (href.startsWith('/') || href.startsWith('mailto:') ? {} : external);
---
<footer class="footer">
  <div class="shell-container footer__inner">
    <div class="footer__brand">
      <a class="brand" href="/"><Logo /><span>Apertis</span></a>
      <p class="footer__line">Apertis AI by STIMA AI LLC.</p>
      <a class="footer__status" href="https://status.apertis.ai" {...external}>Service status</a>
    </div>
    <div class="footer__columns">
      {columns.map((c) => (
        <div>
          <p class="footer__title">{c.title}</p>
          <ul>
            {c.links.map(([label, href, badge]) => (
              <li><a href={href} {...attrs(href)}>{label}</a>{badge && <Badge variant="outline" className="footer__badge text-muted-foreground">{badge}</Badge>}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
  <div class="shell-container footer__bottom">
    <ul class="footer__trust" aria-label="Trust">
      {trust.map(([name, fact, href]) => <li><a href={href} {...external}><span>{name}</span> {fact}</a></li>)}
    </ul>
    <div class="footer__legal">
      <p class="footer__copyright">© 2026 STIMA AI LLC</p>
      <ul>
        {bottom.map(([label, href]) => <li><a href={href} {...external}>{label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
