---
// "On this page" from the rendered body's headings (h2, with h3 nested), as the legacy TOC.
import { tocTree, type TocHeading } from './navigation.ts';

interface Props {
  headings: TocHeading[];
}
const tree = tocTree(Astro.props.headings);
---
<ul class="toc">
  {tree.map(({ h, children }) => (
    <li>
      <a href={`#${h.slug}`}>{h.text}</a>
      {children.length > 0 && <ul>{children.map((c) => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}</ul>}
    </li>
  ))}
</ul>
