---
// Copy/View as Markdown and the AI-tool links (openspec docs-shell-interfaces "Same-release Markdown
// actions"). Rendered only for pages with a Markdown artifact; shell.client.ts reads the
// `apertis-docs:markdown` meta and fills the absolute same-origin URLs, View included: the actions sit in
// the page header inside <article>, which must carry only the body's links (and they are hidden without JS).
interface Props {
  markdownPath: string;
}
const { markdownPath } = Astro.props;
const copy = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
const out = '<svg class="ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';
const spark = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4"/></svg>';
const chat = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>';
const cube = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 2 9 5v10l-9 5-9-5V7z"/><path d="m3 7 9 5 9-5M12 12v10"/></svg>';
const link = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>';
const file = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>';
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---
<div class="page-actions" data-page-actions>
  <div class="page-actions__split">
    <button type="button" class="page-actions__primary" data-action="copy-markdown"><Fragment set:html={copy} /><span data-copy-label>Copy as Markdown</span></button>
    <button type="button" class="page-actions__toggle" aria-label="Open AI tools">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
  </div>
  <div class="page-actions__menu">
    <a data-action="claude" {...ext}><Fragment set:html={spark} /><span>Ask Claude</span><Fragment set:html={out} /></a>
    <a data-action="chatgpt" {...ext}><Fragment set:html={chat} /><span>Ask ChatGPT</span><Fragment set:html={out} /></a>
    <a data-action="cursor" {...ext}><Fragment set:html={cube} /><span>Open in Cursor</span><Fragment set:html={out} /></a>
    <hr />
    <button type="button" data-action="copy-markdown"><Fragment set:html={copy} /><span>Copy as Markdown</span></button>
    <button type="button" data-action="copy-url"><Fragment set:html={link} /><span>Copy content URL</span></button>
    <a data-action="view" data-markdown-path={markdownPath} {...ext}><Fragment set:html={file} /><span>View as Markdown</span><Fragment set:html={out} /></a>
  </div>
  <p class="page-actions__status" role="status" aria-live="polite"></p>
</div>
