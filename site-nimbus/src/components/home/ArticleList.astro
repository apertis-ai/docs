---
// Published native articles, newest first, as dated rows (the claude.dev blog index pattern): date,
// title with its category, reading time. `limit` trims the list (the homepage shows three). `filter`
// adds category buttons once there are two or more categories (the /blog/ index); without JS every row shows.
// `describe` puts the article's description under its title (the /blog/ index; the homepage stays one line).
// The rows themselves come from article-rows.ts.
import { displayDate } from '../shell/page-header.ts';
import { articleRows, type ArticleRow } from './article-rows.ts';

interface Props {
  limit?: number;
  filter?: boolean;
  describe?: boolean;
  /** The rows to list (a tag's or an author's articles); every published article when absent. */
  rows?: ArticleRow[];
  /** Give each row the id `article-<slug>`, so a table of contents can link to it. */
  anchors?: boolean;
}
const { limit, filter = false, describe = false, anchors = false } = Astro.props;
const rows = (Astro.props.rows ?? await articleRows()).slice(0, limit);
const categories = [...new Set(rows.map((r) => r.category))].sort();
---
{filter && categories.length >= 2 && (
  <div class="article-filter" role="group" aria-label="Filter articles by category">
    <button type="button" aria-pressed="true" data-category="">All</button>
    {categories.map((c) => <button type="button" aria-pressed="false" data-category={c}>{c}</button>)}
  </div>
  <script is:inline>document.querySelectorAll('.article-filter').forEach((g) => g.addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    for (const x of g.querySelectorAll('button')) x.setAttribute('aria-pressed', String(x === b));
    for (const li of g.parentElement.querySelectorAll('.article-list li')) li.hidden = !!b.dataset.category && li.dataset.category !== b.dataset.category;
  }));</script>
)}
<ol class="article-list">
  {rows.map((r) => (
    <li data-category={r.category} id={anchors ? `article-${r.slug}` : undefined}>
      <a class="article-row" href={r.doc.servedPath}>
        <time class="article-row__date" datetime={r.date}>{displayDate(r.date)}</time>
        <span class="article-row__title">{r.doc.title}<span class="article-row__category">{r.category}</span>{describe && <span class="article-row__desc">{r.description}</span>}</span>
        <span class="article-row__time">{r.minutes} min</span>
      </a>
    </li>
  ))}
</ol>
