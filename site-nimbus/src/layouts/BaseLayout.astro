---
// The page frame shared by every page: head, navbar, navigation sheet, footer, the Ask Docs trigger and
// the one <AssistantRoot />. DocLayout adds the docs chrome; the landing page uses this directly.
// app.css is the one stylesheet entry (Tailwind, shadcn tokens, shell and reading layout).
import '../styles/app.css';
import { Sparkles } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import NavSheet from '../components/shell/NavSheet.tsx';
import DocumentHead from '../components/DocumentHead.astro';
import AssistantRoot from '../components/assistant/AssistantRoot.astro';
import Navbar from '../components/shell/Navbar.astro';
import Footer from '../components/shell/Footer.astro';
import Sidebar from '../components/shell/Sidebar.astro';
import type { ManifestDocument } from '../contracts/manifest.ts';
import type { PageNavigation } from '../components/shell/navigation.ts';

interface Props {
  doc: ManifestDocument;
  buildId: string;
  nav?: PageNavigation | null;
}
const { doc, buildId, nav = null } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <DocumentHead doc={doc} buildId={buildId} />
    <link rel="icon" href="/img/favicon.ico" />
    <!-- Light by default, the reader's switch wins, never prefers-color-scheme (same key as the legacy site). -->
    <script is:inline>document.documentElement.classList.add('js');try{if(localStorage.getItem('theme')==='dark')document.documentElement.dataset.theme='dark'}catch(e){}</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <!-- The LINE Seed display face is deliberately not preloaded: on the mobile perf profile a preload
         competes with the render-blocking CSS and cost about 150 ms of LCP on every page (paired perf, m9). -->
    <slot name="head" />
  </head>
  <!-- Document pages frame the header and footer on the docs grid (shell.css [data-frame='docs']). -->
  <body data-frame={nav ? 'docs' : undefined}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Navbar sidebar={nav?.sidebar ?? null} />
    <NavSheet client:idle current={nav?.sidebar ?? null}>
      {nav && <Sidebar slot="sidebar" nav={nav} />}
    </NavSheet>
    <slot />
    <Footer />
    <button type="button" data-slot="button" class={cn(buttonVariants({ variant: 'outline' }), 'ask-docs-trigger')} data-open-surface="ask" aria-label="Ask Docs">
      <Sparkles className="size-4" aria-hidden="true" />
      <span>Ask Docs</span>
    </button>
    <AssistantRoot />
    <script>
      import '../components/shell/shell.client.ts';
    </script>
  </body>
</html>
