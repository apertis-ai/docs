---
// Landing page (openspec docs-shell-interfaces "Shell alignment, header, footer and homepage", revised on
// 2026-10-02 after the OpenAI developers, Claude docs and claude.dev homepages): the entry to Apertis guides,
// reference, release notes and articles, kept calm. A left-aligned hero (heading, one line, the primary
// action and the console, then the providers in one monochrome row), "Models" (the featured models of the
// committed catalog snapshot), "Start building" (the six legacy feature-card destinations as shadcn Items)
// and "Latest" (release notes from the committed changelog snapshot, and articles once one is published).
// Search is the header's. Everything here is server-rendered without client JavaScript.
import { ArrowRight, ArrowUpRight } from 'lucide-react';
import openai from '@lobehub/icons-static-svg/icons/openai.svg?raw';
import anthropic from '@lobehub/icons-static-svg/icons/anthropic.svg?raw';
import google from '@lobehub/icons-static-svg/icons/google.svg?raw';
import xai from '@lobehub/icons-static-svg/icons/xai.svg?raw';
import deepseek from '@lobehub/icons-static-svg/icons/deepseek.svg?raw';
import meta from '@lobehub/icons-static-svg/icons/meta.svg?raw';
import qwen from '@lobehub/icons-static-svg/icons/qwen.svg?raw';
import kimi from '@lobehub/icons-static-svg/icons/kimi.svg?raw';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/home/ArticleList.astro';
import FeaturedModels from '../components/home/FeaturedModels.tsx';
import StartBuilding from '../components/home/StartBuilding.tsx';
import ReleaseNotes from '../components/home/ReleaseNotes.tsx';
import catalog from '../components/home/featured-models.json';
import { isNativeArticle } from '../contracts/articles.ts';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { documentAt, manifest } from '../manifest/manifest.ts';

const doc = documentAt('/');
// Articles join "Latest" once a native article is published (none yet: release notes only).
const hasArticles = manifest.documents.some(isNativeArticle);
const ext = { target: '_blank', rel: 'noopener noreferrer' };
// Monochrome provider marks (currentColor), their <title> dropped: the name beside each mark labels it.
const mark = (svg: string) => svg.replace(/<title>[\s\S]*?<\/title>/, '');
const providers = [
  ['OpenAI', openai], ['Anthropic', anthropic], ['Google', google], ['xAI', xai],
  ['DeepSeek', deepseek], ['Meta', meta], ['Qwen', qwen], ['Kimi', kimi],
].map(([name, svg]) => ({ name, svg: mark(svg) }));
---
<BaseLayout doc={doc} buildId={manifest.buildId}>
  <main class="landing" id="main">
    <section class="shell-container hero" aria-labelledby="hero-title">
      <h1 class="hero__title" id="hero-title">Build with Apertis</h1>
      <p class="hero__lead">One API key for models across leading providers. Guides, reference, release notes and articles, from your first request to production.</p>
      <div class="hero__actions">
        <a data-slot="button" data-variant="default" class={buttonVariants({ size: 'lg' })} href="/getting-started/quick-start/">Get started<ArrowRight className="size-4" aria-hidden="true" /></a>
        <a data-slot="button" data-variant="outline" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'bg-card')} href="https://apertis.ai/setting?tab=keys" {...ext}>Create an API key<ArrowUpRight className="size-4" aria-hidden="true" /></a>
      </div>
      <ul class="providers" aria-label="Model providers">
        {providers.map((p) => <li><span class="providers__mark" aria-hidden="true" set:html={p.svg} />{p.name}</li>)}
      </ul>
    </section>

    <section class="shell-container home-section" id="models" aria-labelledby="models-title">
      <h2 id="models-title">Models</h2>
      <p class="home-section__lead">One key reaches {catalog.total} models. Start with one of these.</p>
      <FeaturedModels />
      <p class="home-section__more"><a href="https://apertis.ai/models" {...ext}>Browse all {catalog.total} models<ArrowUpRight className="size-3.5" aria-hidden="true" /></a></p>
    </section>

    <section class="shell-container home-section" id="start" aria-labelledby="start-title">
      <h2 id="start-title">Start building</h2>
      <StartBuilding />
    </section>

    <section class="shell-container home-section" aria-labelledby="latest-title">
      <h2 id="latest-title">Latest</h2>
      <div class:list={['latest', { 'latest--two': hasArticles }]}>
        {hasArticles && (
          <div>
            <h3>Articles</h3>
            <ArticleList limit={3} />
            <p class="home-section__more"><a href="/blog/">All articles<ArrowRight className="size-3.5" aria-hidden="true" /></a></p>
          </div>
        )}
        <div>
          <h3>Release notes</h3>
          <ReleaseNotes />
          <p class="home-section__more"><a href="https://apertis.ai/changelog" {...ext}>All release notes<ArrowUpRight className="size-3.5" aria-hidden="true" /></a></p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
