---
// Landing page (openspec docs-shell-interfaces "Shell alignment, header, footer and homepage"): a
// left-aligned two-column hero (search, three quick links, the Quick Start request in tabs), then two
// sections in one rhythm (eyebrow, heading, one line, content). Copy is reused from the legacy landing
// page and the docs; every destination of the six legacy feature cards stays linked (`.feature-card`).
// Everything here is server-rendered; only the code tabs hydrate.
import { Code } from 'astro:components';
import {
  Activity, ArrowRight, ArrowUpRight, BookOpen, Bot, Code as CodeIcon, CreditCard, Gauge, KeyRound, Layers, Play,
  Rocket, Search, Shield, SquareTerminal, Zap,
} from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCode from '../components/home/HeroCode.tsx';
import { Card } from '@/components/ui/card';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { noTokenizeTimeLimit } from '@/lib/shiki';
import { documentAt, manifest } from '../manifest/manifest.ts';
import quickStart from '../content/public/getting-started/quick-start.md?raw';

const doc = documentAt('/');

// The hero sample is the Quick Start request, read from its clean Markdown so the two never drift.
function fenced(heading: string, lang: string): string {
  const at = quickStart.indexOf(`### ${heading}\n`);
  const block = at < 0 ? null : new RegExp('```' + lang + '\\n([\\s\\S]*?)\\n```').exec(quickStart.slice(at));
  if (!block) throw new Error(`quick-start.md: no \`${lang}\` block under "### ${heading}" for the homepage hero`);
  return block[1];
}
const sources = { curl: fenced('Using cURL', 'bash'), python: fenced('Using Python', 'python'), node: fenced('Using Node.js', 'javascript') };
const themes = { light: 'github-light', dark: 'github-dark' } as const;

const ext = { target: '_blank', rel: 'noopener noreferrer' };
const quickLinks = [
  { label: 'Quick start', href: '/getting-started/quick-start/' },
  { label: 'API keys', href: '/authentication/api-keys/' },
  { label: 'API reference', href: '/api/' },
];

// Cards and their descriptions come from the legacy feature cards.
const paths = [
  {
    icon: CodeIcon, title: 'API', description: 'Integrate with our SDK. Compatible with OpenAI and Anthropic client libraries.',
    links: [['Chat completions', '/api/text-generation/chat-completions/'], ['Messages API', '/api/text-generation/messages/'], ['Python SDK', '/api/sdks/python-sdk/']],
  },
  {
    icon: Bot, title: 'Coding agents', description: 'Purpose-built for Claude Code, Cursor, Cline, and other coding tools.',
    links: [['Claude Code', '/installation/claude-code/'], ['Cursor', '/installation/cursor/'], ['Cline', '/installation/cline/']],
  },
  {
    icon: CreditCard, title: 'Pricing & plans', description: 'Subscription plans with fixed quota per request, or pay-as-you-go per token.',
    links: [['Subscription plans', '/billing/subscription-plans/'], ['Pay-as-you-go', '/billing/payg/'], ['Rate limits', '/billing/rate-limits/']],
  },
];

// `feature` marks the six legacy feature-card destinations (same hrefs as before the redesign).
const journey = [
  {
    step: 'Get started', tiles: [
      { icon: BookOpen, label: 'Introduction', href: '/intro', feature: true },
      { icon: Rocket, label: 'Quick start', href: '/getting-started/quick-start/' },
      { icon: KeyRound, label: 'API keys', href: '/authentication/api-keys/' },
      { icon: Layers, label: 'Browse models', href: '/installation/models', feature: true },
    ],
  },
  {
    step: 'Build', tiles: [
      { icon: CodeIcon, label: 'API reference', href: '/api', feature: true },
      { icon: SquareTerminal, label: 'Coding agents', href: '/installation/claude-code', feature: true },
      { icon: Zap, label: 'Streaming', href: '/api/text-generation/streaming/' },
      { icon: Play, label: 'Playground', href: 'https://playground.apertis.ai', feature: true, external: true },
    ],
  },
  {
    step: 'Operate', tiles: [
      { icon: CreditCard, label: 'Subscription plans', href: '/billing/subscription-plans', feature: true },
      { icon: Gauge, label: 'Quota management', href: '/billing/quota-management/' },
      { icon: Activity, label: 'Error codes', href: '/help/error-codes/' },
      { icon: Shield, label: 'Best practices', href: '/security/best-practices/' },
    ],
  },
];
---
<BaseLayout doc={doc} buildId={manifest.buildId}>
  <main class="landing" id="main">
    <section class="shell-container hero" aria-labelledby="hero-title">
      <div class="hero__copy">
        <p class="eyebrow">Apertis Documentation</p>
        <h1 class="hero__title" id="hero-title">Build with Apertis</h1>
        <p class="hero__sub">One API key for models across leading providers. Smart routing, auto-failover, and free prompt caching built in.</p>
        <button type="button" class="hero__search" data-open-surface="search">
          <Search className="size-4" aria-hidden="true" />
          <span>Search docs or ask AI...</span>
          <kbd>⌘K</kbd>
        </button>
        <ul class="hero__quick" aria-label="Quick links">
          {quickLinks.map((l) => (
            <li><a data-slot="button" class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'bg-card')} href={l.href}>{l.label}<ArrowRight className="size-3.5" aria-hidden="true" /></a></li>
          ))}
        </ul>
      </div>
      <Card className="hero__code gap-0 overflow-hidden py-0 shadow-none">
        <HeroCode client:visible sources={sources}>
          <Code slot="curl" code={sources.curl} lang="bash" themes={themes} defaultColor={false} transformers={[noTokenizeTimeLimit]} />
          <Code slot="python" code={sources.python} lang="python" themes={themes} defaultColor={false} transformers={[noTokenizeTimeLimit]} />
          <Code slot="node" code={sources.node} lang="javascript" themes={themes} defaultColor={false} transformers={[noTokenizeTimeLimit]} />
        </HeroCode>
      </Card>
    </section>

    <section class="shell-container home-section" aria-labelledby="paths-title">
      <p class="eyebrow">Paths</p>
      <h2 id="paths-title">Choose how you build</h2>
      <p class="home-section__desc">Access OpenAI, Anthropic, Google, Meta, and more through a single API key.</p>
      <div class="paths">
        {paths.map((p) => (
          <Card className="path-card gap-4 px-6 shadow-none">
            <p.icon className="size-5 text-foreground" aria-hidden="true" />
            <h3>{p.title}</h3>
            <p class="path-card__desc">{p.description}</p>
            <ul>
              {p.links.map(([label, href]) => <li><a href={href}>{label}<ArrowRight className="size-3.5" aria-hidden="true" /></a></li>)}
            </ul>
          </Card>
        ))}
      </div>
    </section>

    <section class="shell-container home-section" aria-labelledby="journey-title">
      <p class="eyebrow">Journey</p>
      <h2 id="journey-title">From first call to production</h2>
      <p class="home-section__desc">Make your first API call in minutes with our OpenAI-compatible endpoint.</p>
      <ol class="journey">
        {journey.map((j, i) => (
          <li class="journey__step">
            <p class="journey__label"><span class="journey__num">{i + 1}</span>{j.step}</p>
            <ul class="journey__tiles">
              {j.tiles.map((t) => (
                <li>
                  <a class:list={['tile', { 'feature-card': t.feature }]} href={t.href} {...(t.external ? ext : {})}>
                    <t.icon className="size-4" aria-hidden="true" />
                    <span>{t.label}</span>
                    {t.external && <ArrowUpRight className="tile__ext size-3.5" aria-hidden="true" />}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>
