---
// Native articles (openspec docs-routing-publication "Native articles"): /blog/<slug>/ for every native
// manifest entry, and the /blog/ index, which says the first articles are on their way while none is
// published (operator review 2026-10-03: readers should know articles live here). Publication is decided
// by the converter (drafts get no manifest entry); the collection only supplies the body and front matter.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DocLayout from '../../layouts/DocLayout.astro';
import ArticleList from '../../components/home/ArticleList.astro';
import { isNativeArticle, titleId } from '../../contracts/articles.ts';
import type { ManifestDocument } from '../../contracts/manifest.ts';
import { manifest } from '../../manifest/manifest.ts';

export async function getStaticPaths() {
  const native = manifest.documents.filter(isNativeArticle);
  const entries = new Map((await getCollection('articles')).map((e) => [e.id, e]));
  const pages = native.map((doc) => {
    const entry = entries.get(doc.servedPath.slice('/blog/'.length, -1));
    if (!entry) throw new Error(`${doc.id}: no article source; run node converter/convert.ts`);
    return { params: { path: doc.servedPath.slice('/blog/'.length, -1) }, props: { doc, entry } };
  });
  return [{ params: { path: undefined }, props: {} }, ...pages];
}

interface Props {
  doc?: ManifestDocument;
  entry?: CollectionEntry<'articles'>;
}
const { doc, entry } = Astro.props;
const hasArticles = manifest.documents.some(isNativeArticle);
const rendered = entry ? await render(entry) : null;
const data = entry?.data as { title: string; description: string; author: string; category: string } | undefined;
// The index is not a manifest document (like /search/): it is never indexed and has no Markdown.
const index: ManifestDocument = {
  id: 'page:blog', sourcePath: '', servedPath: '/blog/', canonicalUrl: 'https://docs.apertis.ai/blog/', title: 'Blog',
  eligibility: { publish: true, search: false, agent: false, rag: false }, markdown: null, contentSha256: '',
};
---
{doc && rendered && data ? (
  <DocLayout doc={doc} buildId={manifest.buildId} headings={rendered.headings} article={{ category: data.category, author: data.author, description: data.description }}>
    <h1 id={titleId(data.title)}>{data.title}</h1>
    <rendered.Content />
  </DocLayout>
) : (
  <BaseLayout doc={index} buildId={manifest.buildId} noindex={!hasArticles}>
    <main class="shell-container blog-index" id="main">
      <div class="blog-index__intro">
        <h1>Apertis blog</h1>
        <p>Guides, updates and field notes from the team building Apertis.</p>
      </div>
      <div class="blog-index__list">
        {hasArticles ? <ArticleList filter /> : (
          <p class="blog-index__empty">The first articles are on their way: guides, engineering notes and model deep dives. Until then, see what ships in the <a href="https://apertis.ai/changelog" target="_blank" rel="noopener noreferrer">release notes</a>.</p>
        )}
      </div>
    </main>
  </BaseLayout>
)}
