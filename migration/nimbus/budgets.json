    "metrics": {
      "htmlGzip": "gzip -9 bytes of same-origin document responses during load (recorded, not gated).",
      "jsGzip": "gzip -9 bytes of every same-origin script response until 500 ms without same-origin requests in flight after load (includes lazy chunks and worker scripts).",
      "cssGzip": "Same window, stylesheet responses.",
      "dataGzip": "Same window, every other same-origin response except document, image, font and media (fetch/XHR/JSON/WASM, e.g. a preloaded search index).",
      "mediaGzip": "Same window, image, font and media responses (recorded, not gated).",
      "searchPayloadGzip": "gzip -9 bytes of every same-origin response (any type, including requests made by workers) that arrives from pressing Cmd/Ctrl+K until the dialog text for searchPayloadQuery has been unchanged for searchSettleMs and no same-origin request has been in flight for 500 ms.",
      "lcp": "largest-contentful-paint startTime (ms) observed until network idle + 1 s.",
      "tbt": "Sum over long tasks of (duration - 50 ms) observed until network idle + 1 s.",
      "searchOpenMs": "Wall time from pressing Cmd/Ctrl+K until a visible text input exists inside a dialog (`<dialog open>` or role=dialog). Focus is reported separately as keyboardFocus.",
      "keyboardFocus": "1 when that input holds keyboard focus 300 ms after the shortcut, else 0 (the candidate must be 1).",
      "loadAvg1m": "Host 1-minute load average when the sample finished (context for timing)."
    },
    "responseAccounting": "The phase of a response is fixed when the response arrives; every body is read before the browser context closes; redirects are skipped; unreadableResponses must be 0 for a valid sample."
  },
  "budgetRules": {
    "bytes": "For jsGzip, cssGzip, dataGzip and searchPayloadGzip, the candidate median for each page and profile must be <= the recorded legacy median. Zero tolerance. htmlGzip and mediaGzip are recorded only.",
    "timing": "For lcp, tbt and searchOpenMs, run legacy and candidate in the same window on the same machine, alternating per page, and require candidate median <= max(paired legacy median x 1.10, paired legacy median + 50 ms). The recorded timing baseline is informational.",
    "enforcement": "Every page and profile is gated; a single exceedance fails the performance gate. Budgets are not re-derived from candidate results and are never relaxed without a recorded decision on #4."
  },
